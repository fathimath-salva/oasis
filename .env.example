# THE OASIS UNISEX SALON & SPA — Environment Configuration

# Supabase API Credentials (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Salon Details
VITE_SALON_NAME="THE OASIS UNISEX SALON & SPA"
VITE_SALON_LOCATION="Puttur, Karnataka"
VITE_SALON_PHONE="9151550077"
VITE_TIMEZONE="Asia/Kolkata"
VITE_CURRENCY="INR"

# Required to enable email enquiries. Configure a server-side endpoint that sends
# the submitted JSON to this salon address; never place provider secrets in VITE_ variables.
VITE_SALON_EMAIL=
VITE_ENQUIRY_ENDPOINT=
