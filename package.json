{
  "name": "oasis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:prices": "node --experimental-strip-types --test tests/price-display.test.mjs",
    "test:demo": "node --experimental-strip-types --test tests/demo-state.test.mjs",
    "test:auth": "node --experimental-strip-types --test tests/auth-flow.test.mjs",
    "test:security": "node --experimental-strip-types --test tests/authorization.test.mjs",
    "test": "npm run test:prices && npm run test:demo && npm run test:security && npm run test:auth",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^1.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
